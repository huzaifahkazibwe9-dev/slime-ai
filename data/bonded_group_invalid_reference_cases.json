{
  "schema_version": 1,
  "purpose": "Synthetic negative fixtures for fail-closed bonded-group validation, canonical identity and selection. These cases pin the GameState contract and are not observations of live game behavior.",
  "cases": [
    {
      "id": "asymmetric_pair_is_invalid_and_not_selectable",
      "board": [
        [
          "red"
        ]
      ],
      "shooters": [
        {
          "id": "A",
          "color": "red",
          "ammo": 1,
          "direction": "right",
          "x": -1,
          "y": 0,
          "accessible": true,
          "group_id": null,
          "bonded_ids": [
            "B"
          ]
        },
        {
          "id": "B",
          "color": "red",
          "ammo": 1,
          "direction": "right",
          "x": -1,
          "y": 0,
          "accessible": true,
          "group_id": null,
          "bonded_ids": []
        }
      ],
      "start_shooter_id": "A",
      "expected_validation_errors": [
        "Asymmetric bond: A and B"
      ],
      "expected_group": [
        "A",
        "B"
      ],
      "expected_group_id": "A",
      "expected_selectable": false
    },
    {
